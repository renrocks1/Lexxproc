# Servidor
PORT=3000
# DB_PATH=./data/lexxproc.db
# Protege a API com um token (header Authorization: Bearer <token>). Vazio = aberto.
API_TOKEN=
# 1 = usa dados fictícios (sem rede, sem chaves)
DEMO_MODE=0
CACHE_TTL_SECONDS=21600
RATE_LIMIT_PER_MINUTE=60

# DataJud (CNJ) — fonte oficial e gratuita. A chave pública padrão já vem configurada;
# troque aqui se o CNJ divulgar uma nova: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_ENABLED=1
# DATAJUD_API_KEY=

# Provedores comerciais (opcionais) — habilitam busca por nome, CPF/CNPJ e OAB e exibem partes/advogados
ESCAVADOR_TOKEN=
JUDIT_API_KEY=

# Monitoramento
MONITOR_ENABLED=1
MONITOR_INTERVAL_MINUTES=360
# Recebe um POST JSON a cada nova movimentação detectada
MONITOR_WEBHOOK_URL=
