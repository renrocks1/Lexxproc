# Servidor
PORT=3000
# DB_PATH=./data/lexxproc.db
# Protege a API com um token (header Authorization: Bearer <token>). Vazio = aberto.
API_TOKEN=
# 1 = usa dados fictícios (sem rede, sem chaves)
DEMO_MODE=0
CACHE_TTL_SECONDS=21600
RATE_LIMIT_PER_MINUTE=60

# DataJud (CNJ) — fonte oficial e gratuita. A chave pública padrão já vem configurada;
# troque aqui se o CNJ divulgar uma nova: https://datajud-wiki.cnj.jus.br/api-publica/acesso
DATAJUD_ENABLED=1
# DATAJUD_API_KEY=

# Raspagem das consultas públicas dos tribunais (e-SAJ: TJSP, TJAL, TJAM, TJMS, TJAC, TJCE)
SCRAPER_ENABLED=1
# Restringe a alguns tribunais (ex.: TJSP,TJAL). Vazio = todos os disponíveis.
SCRAPER_TRIBUNAIS=
# Intervalo mínimo entre requisições ao mesmo portal, em ms
SCRAPER_MIN_INTERVAL_MS=1500
# Pausa do portal após CAPTCHA ou falhas consecutivas, em minutos
SCRAPER_PAUSE_MINUTES=30
# Páginas de resultados (25 por página) por tribunal na busca por nome/CPF/OAB
SCRAPER_MAX_PAGES=4
SCRAPER_MAX_MOVEMENT_PAGES=20
# SCRAPER_USER_AGENT=

# Provedores comerciais (opcionais) — habilitam busca por nome, CPF/CNPJ e OAB e exibem partes/advogados
ESCAVADOR_TOKEN=
JUDIT_API_KEY=

# Monitoramento
MONITOR_ENABLED=1
MONITOR_INTERVAL_MINUTES=360
# Recebe um POST JSON a cada nova movimentação detectada
MONITOR_WEBHOOK_URL=
